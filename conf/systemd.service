[Unit]
Description=rpimon - monitoring du Raspberry Pi (collecte + interface web)
After=network.target time-sync.target

[Service]
Type=simple
User=__APP__
Group=__APP__
# accès à /dev/vchiq pour vcgencmd (fréquence réelle, sous-tension, bridage)
SupplementaryGroups=video
WorkingDirectory=__INSTALL_DIR__/
ExecStart=/usr/bin/python3 __INSTALL_DIR__/rpimon-cli --config __INSTALL_DIR__/rpimon.conf run
Restart=on-failure
RestartSec=15
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Durcissement (pas de PrivateDevices ni DeviceAllow : vcgencmd a besoin de /dev/vchiq)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
